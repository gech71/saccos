
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id            String    @id
  name          String
  address       String?
  contactPerson String?
  members       Member[]
  schoolHistory SchoolHistory[]

  @@map("schools")
}

model User {
  id          String   @id @default(cuid())
  userId      String   @unique
  email       String   @unique
  name        String
  firstName   String?
  lastName    String?
  phoneNumber String?
  roles       Role[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id                       String                  @id
  fullName                 String
  email                    String?                 @unique
  password                 String?
  mustChangePassword       Boolean?                @default(false)
  sex                      String
  phoneNumber              String?                 @unique
  address                  Address?
  emergencyContact         EmergencyContact?
  schoolId                 String
  school                   School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolHistory            SchoolHistory[]
  joinDate                 DateTime
  salary                   Float?
  status                   String                  @default("active") // active, inactive
  closureDate              DateTime?
  memberSavingAccounts     MemberSavingAccount[]
  shares                   SharePayment[]
  memberShareCommitments   MemberShareCommitment[]
  loans                    Loan[]
  guaranteedLoans          LoanGuarantor[]         @relation("Guarantor")
  dividends                Dividend[]
  savings                  Saving[]
  appliedServiceCharges    AppliedServiceCharge[]
  loanRepayments           LoanRepayment[]
  savingsAccountNumber     String?                 @unique // Legacy field, may not be used
  savingAccountTypeId      String? // Legacy field, may not be used
  shareCommitmentsJson     Json? // Legacy field
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@map("members")
}

model Address {
  id          String      @id @default(cuid())
  city        String?
  subCity     String?
  wereda      String?
  kebele      String?
  houseNumber String?
  memberId    String?     @unique
  member      Member?     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  collateralId String?     @unique
  collateral  Collateral? @relation(fields: [collateralId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model EmergencyContact {
  id       String  @id @default(cuid())
  name     String
  phone    String
  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model SchoolHistory {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolName String // Denormalized for historical accuracy
  startDate  DateTime
  endDate    DateTime?
  reason     String?

  @@map("school_histories")
}

// Configuration Entities
model SavingAccountType {
  id                    String                @id @default(cuid())
  name                  String                @unique
  description           String?
  interestRate          Float // 0.05 for 5%
  contributionType      String                @default("FIXED") // FIXED, PERCENTAGE
  contributionValue     Float                 @default(0)
  memberSavingAccounts  MemberSavingAccount[]

  @@map("saving_account_types")
}

model ShareType {
  id                   String                  @id @default(cuid())
  name                 String                  @unique
  description          String?
  totalAmount          Float
  paymentType          String                  @default("ONCE") // ONCE, INSTALLMENT
  numberOfInstallments Int?
  monthlyPayment       Float?
  commitments          MemberShareCommitment[]

  @@map("share_types")
}

model LoanType {
  id                         String   @id @default(cuid())
  name                       String   @unique
  description                String?
  interestRate               Float
  minLoanAmount              Float
  maxLoanAmount              Float
  minRepaymentPeriod         Int
  maxRepaymentPeriod         Int
  repaymentFrequency         String   @default("monthly") // monthly, quarterly, yearly
  nplInterestRate            Float
  nplGracePeriodDays         Int?
  allowConcurrent            Boolean?
  serviceFee                 Float?
  insuranceFeePercentage     Float?
  collateralLogic            String   @default("GUARANTOR") // GUARANTOR, TITLE_DEED, GUARANTOR_OR_SAVINGS_BALANCE, GUARANTOR_AND_TITLE_DEED_OVER_X
  collateralThresholdAmount  Float?
  minSavingMonths            Int?
  minSavingBalance           Float?
  purposes                   String[] @default([])
  loans                      Loan[]

  @@map("loan_types")
}

model ServiceChargeType {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  description           String?
  amount                Float
  frequency             String // once, monthly, yearly
  appliedServiceCharges AppliedServiceCharge[]

  @@map("service_charge_types")
}

// Member-Specific Account & Commitment Models
model MemberSavingAccount {
  id                    String            @id @default(cuid())
  memberId              String
  member                Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  savingAccountTypeId   String
  savingAccountType     SavingAccountType @relation(fields: [savingAccountTypeId], references: [id], onDelete: Restrict)
  accountNumber         String            @unique
  balance               Float             @default(0)
  initialBalance        Float             @default(0)
  expectedMonthlySaving Float?
  savings               Saving[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([memberId, savingAccountTypeId])
  @@map("member_saving_accounts")
}

model MemberShareCommitment {
  id                   String         @id @default(cuid())
  memberId             String
  member               Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shareTypeId          String
  shareType            ShareType?     @relation(fields: [shareTypeId], references: [id], onDelete: SetNull)
  totalCommittedAmount Float
  amountPaid           Float          @default(0)
  status               String         @default("ACTIVE") // ACTIVE, PAID_OFF, PENDING_REFUND, REFUNDED, CANCELLED
  joinDate             DateTime       @default(now())
  payments             SharePayment[]

  @@unique([memberId, shareTypeId])
  @@map("member_share_commitments")
}

// Transactional Models
model Saving {
  id                    String               @id @default(cuid())
  memberId              String
  member                Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberSavingAccountId String?
  memberSavingAccount   MemberSavingAccount? @relation(fields: [memberSavingAccountId], references: [id], onDelete: SetNull)
  amount                Float
  date                  DateTime
  month                 String
  transactionType       String // deposit, withdrawal
  status                String               @default("pending") // pending, approved, rejected
  notes                 String?
  depositMode           String? // Cash, Bank, Wallet
  sourceName            String?
  transactionReference  String?
  evidenceUrl           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@map("savings")
}

model SharePayment {
  id           String                @id @default(cuid())
  commitmentId String
  commitment   MemberShareCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  amount       Float
  paymentDate  DateTime
  status       String                @default("pending") // pending, approved, rejected
  notes        String?
  depositMode  String? // Cash, Bank, Wallet
  sourceName   String?
  transactionReference String?
  evidenceUrl  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  memberId     String
  member       Member                @relation(fields: [memberId], references: [id])

  @@map("share_payments")
}

model Dividend {
  id                       String   @id @default(cuid())
  memberId                 String
  member                   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount                   Float
  distributionDate         DateTime
  shareCountAtDistribution Int
  status                   String   @default("pending") // pending, approved, rejected
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("dividends")
}

model Loan {
  id                     String          @id @default(cuid())
  loanAccountNumber      String?         @unique
  memberId               String
  member                 Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanTypeId             String
  loanType               LoanType        @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  principalAmount        Float
  interestRate           Float
  loanTerm               Int
  repaymentFrequency     String
  disbursementDate       DateTime
  status                 String          @default("pending") // pending, active, paid_off, rejected, overdue
  remainingBalance       Float
  nextDueDate            DateTime?
  notes                  String?
  purpose                String?
  insuranceFee           Float?
  serviceFee             Float?
  monthlyRepaymentAmount Float?
  repayments             LoanRepayment[]
  guarantors             LoanGuarantor[]
  collaterals            Collateral[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@map("loans")
}

model LoanRepayment {
  id                   String   @id @default(cuid())
  loanId               String
  loan                 Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId             String
  member               Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amountPaid           Float
  principalPaid        Float
  interestPaid         Float
  paymentDate          DateTime
  status               String   @default("approved") // pending, approved, rejected
  notes                String?
  depositMode          String? // Cash, Bank, Wallet
  sourceName           String?
  transactionReference String?
  evidenceUrl          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("loan_repayments")
}

model LoanGuarantor {
  loanId      String
  loan        Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantorId String
  guarantor   Member @relation(name: "Guarantor", fields: [guarantorId], references: [id], onDelete: Cascade)

  @@id([loanId, guarantorId])
  @@map("loan_guarantors")
}

model Collateral {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type        String // e.g., 'TITLE_DEED', 'VEHICLE'
  description String?
  documentUrl String?
  address     Address?

  @@map("collaterals")
}

model AppliedServiceCharge {
  id                  String            @id @default(cuid())
  memberId            String
  member              Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceChargeTypeId String
  serviceChargeType   ServiceChargeType @relation(fields: [serviceChargeTypeId], references: [id], onDelete: Restrict)
  amountCharged       Float
  dateApplied         DateTime
  status              String            @default("pending") // pending, paid, waived
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("applied_service_charges")
}

// Website Content Management
model WebsiteContent {
  id           String            @id @default(cuid())
  saccoName    String?
  logoUrl      String?
  heroTitle    String?
  heroSubtitle String?
  aboutUs      String?
  address      String?
  phone        String?
  email        String?
  socialLinks  SocialMediaLink[]
  services     Service[]
}

model SocialMediaLink {
  id        String          @id @default(cuid())
  name      String
  url       String
  iconUrl   String
  contentId String
  content   WebsiteContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model Service {
  id          String         @id @default(cuid())
  title       String
  description String
  icon        String // Name of a lucide-react icon
  contentId   String
  content     WebsiteContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
