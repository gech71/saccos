// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id              String         @id @default(cuid())
  name            String
  address         String?
  contactPerson   String?
  members         Member[]
  schoolHistories SchoolHistory[]

  @@map("schools")
}

model Member {
  id                        String                   @id
  fullName                  String
  email                     String?                  @unique
  password                  String?
  mustChangePassword        Boolean?                 @default(false)
  passwordResetToken        String?                  @unique
  passwordResetTokenExpires DateTime?
  sex                       String
  phoneNumber               String?                  @unique
  joinDate                  DateTime                 @default(now())
  salary                    Float?
  status                    String                   @default("active") // e.g., active, inactive
  closureDate               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  schoolId                  String
  school                    School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  address                   Address?
  emergencyContact          EmergencyContact?
  savings                   Saving[]
  memberSavingAccounts      MemberSavingAccount[]
  loans                     Loan[]
  loanRepayments            LoanRepayment[]
  guaranteedLoans           LoanGuarantor[]          @relation("Guarantor")
  dividends                 Dividend[]
  schoolHistory             SchoolHistory[]
  memberShareCommitments    MemberShareCommitment[]
  appliedServiceCharges     AppliedServiceCharge[]

  @@map("members")
}

model Address {
  id           String      @id @default(cuid())
  city         String?
  subCity      String?
  wereda       String?
  kebele       String?
  houseNumber  String?
  memberId     String?     @unique
  member       Member?     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  collateralId String?     @unique
  collateral   Collateral? @relation(fields: [collateralId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model EmergencyContact {
  id       String  @id @default(cuid())
  name     String
  phone    String
  memberId String  @unique
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model SchoolHistory {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  schoolName String // Denormalized for historical accuracy
  startDate  DateTime
  endDate    DateTime?
  reason     String?

  @@map("school_histories")
}

// FINANCIAL PRODUCT CONFIGURATION
model SavingAccountType {
  id                  String                @id @default(cuid())
  name                String                @unique
  description         String?
  interestRate        Float
  contributionType    String // FIXED or PERCENTAGE
  contributionValue   Float // The fixed amount or the percentage value
  memberSavingAccount MemberSavingAccount[]

  @@map("saving_account_types")
}

model MemberSavingAccount {
  id                  String             @id @default(cuid())
  memberId            String
  member              Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  savingAccountTypeId String
  savingAccountType   SavingAccountType? @relation(fields: [savingAccountTypeId], references: [id])
  accountNumber       String             @unique
  balance             Float              @default(0)
  initialBalance      Float              @default(0)
  expectedMonthlySaving Float           @default(0)
  createdAt           DateTime           @default(now())
  savings             Saving[]

  @@map("member_saving_accounts")
}

model ShareType {
  id                   String                  @id @default(cuid())
  name                 String                  @unique
  description          String?
  totalAmount          Float
  paymentType          String // ONCE or INSTALLMENT
  numberOfInstallments Int?
  monthlyPayment       Float?
  memberShareCommitment MemberShareCommitment[]

  @@map("share_types")
}

model MemberShareCommitment {
  id                   String         @id @default(cuid())
  memberId             String
  member               Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shareTypeId          String
  shareType            ShareType      @relation(fields: [shareTypeId], references: [id])
  totalCommittedAmount Float
  amountPaid           Float          @default(0)
  status               String         @default("ACTIVE") // ACTIVE, PAID_OFF, PENDING_REFUND, REFUNDED, CANCELLED
  joinDate             DateTime       @default(now())
  payments             SharePayment[]

  @@map("member_share_commitments")
}

model LoanType {
  id                         String    @id @default(cuid())
  name                       String    @unique
  description                String?
  interestRate               Float
  minLoanAmount              Float
  maxLoanAmount              Float
  minRepaymentPeriod         Int // In months
  maxRepaymentPeriod         Int // In months
  repaymentFrequency         String
  nplInterestRate            Float
  nplGracePeriodDays         Int?
  allowConcurrent            Boolean?
  serviceFee                 Float?
  insuranceFeePercentage     Float?
  collateralLogic            String // e.g., GUARANTOR, TITLE_DEED, GUARANTOR_OR_SAVINGS_BALANCE, GUARANTOR_AND_TITLE_DEED_OVER_X
  collateralThresholdAmount  Float?
  minSavingMonths            Int?
  minSavingBalance           Float?
  purposes                   String[]
  loans                      Loan[]

  @@map("loan_types")
}

model ServiceChargeType {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  description           String?
  amount                Float
  frequency             String // e.g., once, monthly, yearly
  appliedServiceCharges AppliedServiceCharge[]

  @@map("service_charge_types")
}

// TRANSACTIONAL RECORDS
model Saving {
  id                    String               @id @default(cuid())
  memberId              String
  member                Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberSavingAccountId String?
  memberSavingAccount   MemberSavingAccount? @relation(fields: [memberSavingAccountId], references: [id], onDelete: SetNull)
  amount                Float
  date                  DateTime
  month                 String?
  transactionType       String // deposit or withdrawal
  status                String
  notes                 String?
  depositMode           String?
  sourceName            String?
  transactionReference  String?
  evidenceUrl           String?

  @@map("savings")
}

model SharePayment {
  id           String                @id @default(cuid())
  commitmentId String
  commitment   MemberShareCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  amount       Float
  paymentDate  DateTime
  status       String
  depositMode  String?
  sourceName   String?
  transactionReference String?
  evidenceUrl  String?
  notes        String?

  @@map("share_payments")
}

model Loan {
  id                     String          @id @default(cuid())
  loanAccountNumber      String?         @unique
  memberId               String
  member                 Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanTypeId             String
  loanType               LoanType        @relation(fields: [loanTypeId], references: [id])
  principalAmount        Float
  interestRate           Float
  loanTerm               Int
  repaymentFrequency     String
  disbursementDate       DateTime
  status                 String
  remainingBalance       Float
  nextDueDate            DateTime?
  notes                  String?
  purpose                String?
  monthlyRepaymentAmount Float?
  serviceFee             Float?
  insuranceFee           Float?
  collaterals            Collateral[]
  repayments             LoanRepayment[]
  guarantors             LoanGuarantor[]

  @@map("loans")
}

model Collateral {
  id          String   @id @default(cuid())
  loanId      String?
  loan        Loan?    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type        String // e.g., GUARANTOR, TITLE_DEED
  description String?
  documentUrl String?
  address     Address?

  @@map("collaterals")
}

model LoanGuarantor {
  id          String @id @default(cuid())
  loanId      String
  loan        Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantorId String
  guarantor   Member @relation("Guarantor", fields: [guarantorId], references: [id], onDelete: Cascade)

  @@map("loan_guarantors")
}

model LoanRepayment {
  id                   String  @id @default(cuid())
  loanId               String
  loan                 Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId             String
  member               Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amountPaid           Float
  principalPaid        Float
  interestPaid         Float
  paymentDate          DateTime
  notes                String?
  status               String? @default("approved")
  depositMode          String?
  sourceName           String?
  transactionReference String?
  evidenceUrl          String?

  @@map("loan_repayments")
}

model Dividend {
  id                       String   @id @default(cuid())
  memberId                 String
  member                   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount                   Float
  distributionDate         DateTime
  shareCountAtDistribution Int
  status                   String
  notes                    String?

  @@map("dividends")
}

model AppliedServiceCharge {
  id                  String             @id @default(cuid())
  memberId            String
  member              Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceChargeTypeId String
  serviceChargeType   ServiceChargeType  @relation(fields: [serviceChargeTypeId], references: [id])
  amountCharged       Float
  dateApplied         DateTime
  status              String
  notes               String?

  @@map("applied_service_charges")
}

// SYSTEM MODELS
model User {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  email                     String    @unique
  name                      String?
  firstName                 String?
  lastName                  String?
  phoneNumber               String?
  roles                     Role[]
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  passwordResetToken        String?   @unique
  passwordResetTokenExpires DateTime?

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String // Comma-separated list of permission keys
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

// WEBSITE CONTENT
model WebsiteContent {
  id              String            @id @default(cuid())
  saccoName       String?
  logo            String?
  primary         String? // Storing as hex color string
  accent          String? // Storing as hex color string
  themeColor      String? // For meta tags
  heroTitle       String?
  heroSubtitle    String?
  heroImageUrl    String?
  aboutUs         String?
  aboutUsImageUrl String?
  address         String?
  phone           String?
  email           String?
  socialLinks     SocialMediaLink[]
  services        Service[]
  heroSlides      HeroSlide[]

  @@map("website_content")
}

model SocialMediaLink {
  id        String          @id @default(cuid())
  name      String
  url       String
  iconUrl   String?
  contentId String?
  content   WebsiteContent? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("social_media_links")
}

model Service {
  id          String          @id @default(cuid())
  title       String
  description String
  icon        String?
  contentId   String?
  content     WebsiteContent? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("services")
}

model HeroSlide {
    id String @id @default(cuid())
    title String
    subtitle String
    imageUrl String
    imageHint String?
    link String
    linkText String
    order Int
    contentId String?
    content WebsiteContent? @relation(fields: [contentId], references: [id], onDelete: Cascade)

    @@map("hero_slides")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("posts")
}
