
// datasource and generator definitions...
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider        = "prisma-client-js"
  // The binaryTargets option is needed for the deployment environment
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

model User {
  id          String   @id @default(uuid())
  userId      String   @unique
  email       String   @unique
  name        String
  firstName   String?
  lastName    String?
  phoneNumber String?
  roles       Role[]
  Member      Member?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id                        String                   @id
  fullName                  String
  sex                       String
  email                     String?                  @unique
  password                  String?
  mustChangePassword        Boolean?                 @default(false)
  phoneNumber               String?                  @unique
  joinDate                  DateTime                 @default(now())
  status                    String                   @default("active") // e.g., active, inactive, suspended
  salary                    Float?
  schoolId                  String
  school                    School                   @relation(fields: [schoolId], references: [id])
  savingsAccountNumber      String?                  @unique
  savingAccountTypeId       String?
  address                   Address?
  emergencyContact          EmergencyContact?
  schoolHistory             SchoolHistory[]
  memberSavingAccounts      MemberSavingAccount[]
  memberShareCommitments    MemberShareCommitment[]
  loans                     Loan[]
  loanRepayments            LoanRepayment[]
  guaranteedLoans           LoanGuarantor[]
  dividends                 Dividend[]
  appliedServiceCharges     AppliedServiceCharge[]
  savings                   Saving[]
  User                      User?                    @relation(fields: [userId], references: [id])
  userId                    String?                  @unique
}

model School {
  id          String         @id
  name        String         @unique
  address     String?
  contactPerson String?
  members     Member[]
  schoolHistory SchoolHistory[]
}

model SchoolHistory {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolName String
  startDate  DateTime
  endDate    DateTime?
  reason     String?
}

model Address {
  id            String      @id @default(uuid())
  city          String?
  subCity       String?
  wereda        String?
  kebele        String?
  houseNumber   String?
  member        Member?     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId      String?     @unique
  collaterals   Collateral[]
}

model EmergencyContact {
  id       String  @id @default(uuid())
  name     String
  phone    String
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String? @unique
}

model SavingAccountType {
  id                     String                @id @default(uuid())
  name                   String                @unique
  description            String?
  interestRate           Float                 @default(0) // Annual interest rate, e.g., 0.05 for 5%
  contributionType       String                @default("FIXED") // FIXED or PERCENTAGE
  contributionValue      Float                 @default(0) // Amount for FIXED or percentage for PERCENTAGE
  memberSavingAccounts   MemberSavingAccount[]
}

model MemberSavingAccount {
  id                     String            @id @default(uuid())
  memberId               String
  member                 Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  savingAccountTypeId    String?
  savingAccountType      SavingAccountType? @relation(fields: [savingAccountTypeId], references: [id])
  accountNumber          String            @unique
  balance                Float             @default(0)
  initialBalance         Float             @default(0)
  expectedMonthlySaving  Float?
  savings                Saving[]
  createdAt              DateTime          @default(now())
}

model Saving {
  id                     String               @id @default(uuid())
  memberId               String
  member                 Member               @relation(fields: [memberId], references: [id])
  memberSavingAccountId  String?
  memberSavingAccount    MemberSavingAccount? @relation(fields: [memberSavingAccountId], references: [id], onDelete: Cascade)
  amount                 Float
  date                   DateTime
  month                  String
  transactionType        String // 'deposit' or 'withdrawal'
  status                 String               @default("pending") // 'pending', 'approved', 'rejected'
  notes                  String?
  depositMode            String? // 'Cash', 'Bank', 'Wallet'
  sourceName             String?
  transactionReference   String?
  evidenceUrl            String?
}

model ShareType {
  id                    String                  @id @default(uuid())
  name                  String                  @unique
  description           String?
  totalAmount           Float
  paymentType           String                  @default("ONCE") // ONCE, INSTALLMENT
  numberOfInstallments  Int?
  monthlyPayment        Float?
  commitments           MemberShareCommitment[]
  payments              SharePayment[]
}

model MemberShareCommitment {
  id                    String         @id @default(uuid())
  memberId              String
  member                Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shareTypeId           String?
  shareType             ShareType?     @relation(fields: [shareTypeId], references: [id], onDelete: SetNull)
  totalCommittedAmount  Float
  amountPaid            Float          @default(0)
  status                String         @default("ACTIVE") // ACTIVE, PAID_OFF, PENDING_REFUND, REFUNDED, CANCELLED
  joinDate              DateTime       @default(now())
  payments              SharePayment[]
}

model SharePayment {
  id                    String                @id @default(uuid())
  commitmentId          String
  commitment            MemberShareCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  shareTypeId           String?
  shareType             ShareType?            @relation(fields: [shareTypeId], references: [id], onDelete: SetNull)
  amount                Float
  paymentDate           DateTime
  status                String                @default("pending") // pending, approved, rejected
  depositMode           String?
  sourceName            String?
  transactionReference  String?
  evidenceUrl           String?
  notes                 String?
}

model Dividend {
  id                         String   @id @default(uuid())
  memberId                   String
  member                     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount                     Float
  distributionDate           DateTime
  shareCountAtDistribution   Int
  status                     String   @default("pending")
  notes                      String?
}

model ServiceChargeType {
  id                     String                 @id @default(uuid())
  name                   String                 @unique
  description            String?
  amount                 Float
  frequency              String                 @default("once") // once, monthly, yearly
  appliedCharges         AppliedServiceCharge[]
}

model AppliedServiceCharge {
  id                     String             @id @default(uuid())
  memberId               String
  member                 Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceChargeTypeId    String
  serviceChargeType      ServiceChargeType  @relation(fields: [serviceChargeTypeId], references: [id], onDelete: Restrict)
  amountCharged          Float
  dateApplied            DateTime
  status                 String             @default("pending") // pending, paid, waived
  notes                  String?
}

model LoanType {
  id                         String      @id @default(uuid())
  name                       String      @unique
  description                String?
  interestRate               Float
  minLoanAmount              Float       @default(1000)
  maxLoanAmount              Float       @default(100000)
  minRepaymentPeriod         Int         @default(1)
  maxRepaymentPeriod         Int         @default(60)
  repaymentFrequency         String      @default("monthly")
  nplInterestRate            Float       @default(0)
  nplGracePeriodDays         Int         @default(30)
  allowConcurrent            Boolean     @default(false)
  serviceFee                 Float?
  insuranceFeePercentage     Float?
  collateralLogic            String      @default("GUARANTOR") // GUARANTOR, TITLE_DEED, GUARANTOR_OR_SAVINGS_BALANCE, GUARANTOR_AND_TITLE_DEED_OVER_X
  collateralThresholdAmount  Float?
  minSavingMonths            Int?
  minSavingBalance           Float?
  purposes                   String[]
  loans                      Loan[]
}

model Loan {
  id                     String          @id @default(uuid())
  loanAccountNumber      String?         @unique
  memberId               String
  member                 Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanTypeId             String
  loanType               LoanType        @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  principalAmount        Float
  interestRate           Float
  loanTerm               Int
  repaymentFrequency     String
  disbursementDate       DateTime
  status                 String          @default("pending")
  remainingBalance       Float
  nextDueDate            DateTime?
  notes                  String?
  purpose                String?
  monthlyRepaymentAmount Float?
  serviceFee             Float?
  insuranceFee           Float?
  repayments             LoanRepayment[]
  guarantors             LoanGuarantor[]
  collaterals            Collateral[]
}

model LoanRepayment {
  id                      String   @id @default(uuid())
  loanId                  String
  loan                    Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId                String
  member                  Member   @relation(fields: [memberId], references: [id])
  amountPaid              Float
  principalPaid           Float    @default(0)
  interestPaid            Float    @default(0)
  paymentDate             DateTime
  status                  String   @default("pending")
  notes                   String?
  depositMode             String?
  sourceName              String?
  transactionReference    String?
  evidenceUrl             String?
}

model LoanGuarantor {
  id           String @id @default(uuid())
  loanId       String
  loan         Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantorId  String
  guarantor    Member @relation(fields: [guarantorId], references: [id], onDelete: Cascade)

  @@unique([loanId, guarantorId])
}

model Collateral {
  id           String   @id @default(uuid())
  loanId       String?
  loan         Loan?    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type         String // E.g., 'TITLE_DEED', 'VEHICLE'
  description  String?
  documentUrl  String?
  addressId    String?  @unique
  address      Address? @relation(fields: [addressId], references: [id])
}

// Website Content Models
model WebsiteContent {
  id              String            @id @default(uuid())
  saccoName       String?
  logoUrl         String?
  heroTitle       String?
  heroSubtitle    String?
  heroImageUrl    String?
  aboutUs         String?
  aboutUsImageUrl String?
  address         String?
  phone           String?
  email           String?
  socialLinks     SocialMediaLink[]
  services        Service[]
}

model SocialMediaLink {
  id        String          @id @default(uuid())
  name      String
  url       String
  iconUrl   String?
  contentId String
  content   WebsiteContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model Service {
  id          String         @id @default(uuid())
  title       String
  description String
  icon        String?
  contentId   String
  content     WebsiteContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
