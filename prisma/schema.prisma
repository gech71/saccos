// datasource db defines the database connection details.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// generator client defines the Prisma Client generator configuration.
generator client {
  provider      = "prisma-client-js"
  // The binaryTargets option is crucial for deployment environments.
  // 'native' ensures Prisma generates the correct engine for the build environment.
  // 'debian-openssl-3.0.x' is added for compatibility with modern Debian-based Linux distributions.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Defines the User model for application administrators and staff.
model User {
  id          String   @id @default(uuid())
  userId      String   @unique
  email       String   @unique
  name        String
  firstName   String?
  lastName    String?
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]
}

// Defines the Role model to manage user permissions.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String // Comma-separated list of permission strings.
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Defines the School model, representing participating institutions.
model School {
  id            String          @id
  name          String
  address       String?
  contactPerson String?
  members       Member[]
  schoolHistory SchoolHistory[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Defines the Member model, representing an individual Saccos member.
model Member {
  id                       String                   @id
  fullName                 String
  email                    String?                  @unique
  password                 String?
  mustChangePassword       Boolean?                 @default(false)
  sex                      String
  phoneNumber              String?                  @unique
  joinDate                 DateTime
  salary                   Float?
  status                   String                   @default("active") // active, inactive, suspended
  closureDate              DateTime?
  // Relations
  school                   School                   @relation(fields: [schoolId], references: [id])
  schoolId                 String
  address                  Address?
  emergencyContact         EmergencyContact?
  savings                  Saving[]
  memberSavingAccounts     MemberSavingAccount[]
  loans                    Loan[]
  loanRepayments           LoanRepayment[]
  guaranteedLoans          LoanGuarantor[]          @relation("Guarantor")
  appliedServiceCharges    AppliedServiceCharge[]
  dividends                Dividend[]
  memberShareCommitments   MemberShareCommitment[]
  schoolHistory            SchoolHistory[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
}

// Defines the Address model, linked to a Member or a Collateral.
model Address {
  id           String      @id @default(uuid())
  city         String
  subCity      String
  wereda       String
  kebele       String?
  houseNumber  String?
  // Relations
  Member       Member?     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId     String?     @unique
  Collateral   Collateral? @relation(fields: [collateralId], references: [id], onDelete: Cascade)
  collateralId String?     @unique
}

// Defines the EmergencyContact model, linked to a Member.
model EmergencyContact {
  id       String  @id @default(uuid())
  name     String
  phone    String
  // Relations
  Member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String? @unique
}

// Defines the SavingAccountType model, which are templates for savings accounts.
model SavingAccountType {
  id                  String                @id @default(uuid())
  name                String                @unique
  description         String?
  interestRate        Float                 @default(0) // Annual interest rate (e.g., 0.05 for 5%)
  contributionType    String                @default("FIXED") // FIXED or PERCENTAGE
  contributionValue   Float                 @default(0)
  // Relations
  memberSavingAccount MemberSavingAccount[]
}

// Represents an individual member's savings account, based on a SavingAccountType.
model MemberSavingAccount {
  id                    String            @id @default(uuid())
  memberId              String
  member                Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  savingAccountTypeId   String
  savingAccountType     SavingAccountType @relation(fields: [savingAccountTypeId], references: [id])
  accountNumber         String            @unique
  balance               Float             @default(0)
  initialBalance        Float             @default(0)
  expectedMonthlySaving Float             @default(0)
  savings               Saving[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([memberId, savingAccountTypeId], name: "member_account_type_unique")
}

// Represents a single savings transaction (deposit or withdrawal).
model Saving {
  id                    String             @id @default(uuid())
  memberId              String
  member                Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberSavingAccountId String?
  memberSavingAccount   MemberSavingAccount? @relation(fields: [memberSavingAccountId], references: [id], onDelete: SetNull)
  amount                Float
  date                  DateTime
  month                 String // e.g., "January 2024"
  transactionType       String // "deposit" or "withdrawal"
  status                String // "pending", "approved", "rejected"
  notes                 String?
  depositMode           String? // "Cash", "Bank", "Wallet"
  sourceName            String?
  transactionReference  String?
  evidenceUrl           String?
}

// Defines the ShareType model, representing different types of shares.
model ShareType {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  description            String?
  totalAmount            Float // Total value of the share commitment
  paymentType            String                  @default("ONCE") // ONCE or INSTALLMENT
  numberOfInstallments   Int?
  monthlyPayment         Float?
  memberShareCommitments MemberShareCommitment[]
}

// Represents a member's commitment to a specific type of share.
model MemberShareCommitment {
  id                   String         @id @default(uuid())
  memberId             String
  member               Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shareTypeId          String
  shareType            ShareType      @relation(fields: [shareTypeId], references: [id])
  totalCommittedAmount Float
  amountPaid           Float          @default(0)
  status               String         @default("ACTIVE") // ACTIVE, PAID_OFF, PENDING_REFUND, REFUNDED
  joinDate             DateTime       @default(now())
  payments             SharePayment[]

  @@unique([memberId, shareTypeId])
}

// Represents a single payment towards a share commitment.
model SharePayment {
  id           String                @id @default(uuid())
  commitmentId String
  commitment   MemberShareCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  amount       Float
  paymentDate  DateTime
  status       String // "pending", "approved", "rejected"
  notes        String?
  depositMode  String?
  sourceName   String?
  transactionReference String?
  evidenceUrl  String?
}

// Represents a dividend distribution to a member.
model Dividend {
  id                       String   @id @default(uuid())
  memberId                 String
  member                   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount                   Float
  distributionDate         DateTime
  shareCountAtDistribution Int
  status                   String // "pending", "approved", "rejected"
  notes                    String?
}

// Defines the LoanType model, which are templates for different loan products.
model LoanType {
  id                         String    @id @default(uuid())
  name                       String    @unique
  description                String?
  interestRate               Float // Annual interest rate as a decimal (e.g., 0.08 for 8%)
  minLoanAmount              Float
  maxLoanAmount              Float
  minRepaymentPeriod         Int // in months
  maxRepaymentPeriod         Int // in months
  repaymentFrequency         String    @default("monthly") // monthly, quarterly, yearly
  nplInterestRate            Float     @default(0) // Non-performing loan interest rate
  nplGracePeriodDays         Int       @default(30)
  allowConcurrent            Boolean   @default(false)
  // Eligibility Criteria
  minSavingMonths            Int       @default(0)
  minSavingBalance           Float     @default(0)
  // Fees
  serviceFee                 Float     @default(0)
  insuranceFeePercentage     Float     @default(0)
  // Collateral Rules
  collateralLogic            String    @default("GUARANTOR") // GUARANTOR, TITLE_DEED, GUARANTOR_OR_SAVINGS_BALANCE, GUARANTOR_AND_TITLE_DEED_OVER_X
  collateralThresholdAmount  Float?
  purposes                   String[] // List of allowed purposes for this loan type
  // Relations
  loans                      Loan[]
}

// Represents an individual loan taken by a member.
model Loan {
  id                     String          @id @default(uuid())
  loanAccountNumber      String?         @unique
  memberId               String
  member                 Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  loanTypeId             String
  loanType               LoanType        @relation(fields: [loanTypeId], references: [id])
  principalAmount        Float
  interestRate           Float // Annual rate at time of loan
  loanTerm               Int // in months
  repaymentFrequency     String
  disbursementDate       DateTime
  status                 String // pending, active, paid_off, rejected, overdue
  remainingBalance       Float
  nextDueDate            DateTime?
  monthlyRepaymentAmount Float?
  serviceFee             Float?
  insuranceFee           Float?
  purpose                String?
  notes                  String?
  // Relations
  repayments             LoanRepayment[]
  guarantors             LoanGuarantor[]
  collaterals            Collateral[]
}

// Represents a member who has guaranteed another member's loan.
model LoanGuarantor {
  id          String @id @default(uuid())
  loanId      String
  loan        Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantorId String
  guarantor   Member @relation("Guarantor", fields: [guarantorId], references: [id], onDelete: Cascade)

  @@unique([loanId, guarantorId])
}

// Represents a physical asset or document used as collateral.
model Collateral {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type        String // e.g., 'TITLE_DEED', 'VEHICLE'
  description String?
  documentUrl String?
  address     Address?
}

// Represents a single repayment made towards a loan.
model LoanRepayment {
  id                   String   @id @default(uuid())
  loanId               String
  loan                 Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  memberId             String
  member               Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amountPaid           Float
  principalPaid        Float
  interestPaid         Float
  paymentDate          DateTime
  status               String   @default("approved") // pending, approved, rejected
  notes                String?
  depositMode          String?
  sourceName           String?
  transactionReference String?
  evidenceUrl          String?
}

// Defines a type of service charge (e.g., annual fee, loan processing fee).
model ServiceChargeType {
  id                   String                 @id @default(uuid())
  name                 String                 @unique
  description          String?
  amount               Float
  frequency            String // once, monthly, yearly
  AppliedServiceCharge AppliedServiceCharge[]
}

// Represents an instance of a service charge being applied to a member.
model AppliedServiceCharge {
  id                  String            @id @default(uuid())
  memberId            String
  member              Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceChargeTypeId String
  serviceChargeType   ServiceChargeType @relation(fields: [serviceChargeTypeId], references: [id])
  amountCharged       Float
  dateApplied         DateTime
  status              String // pending, paid, waived
  notes               String?
}

// Represents a record of a member transferring between schools.
model SchoolHistory {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolName String
  startDate  DateTime
  endDate    DateTime?
  reason     String?
}

// Model for storing general website content.
model WebsiteContent {
  id           String  @id @default(uuid())
  saccoName    String
  heroTitle    String
  heroSubtitle String
  aboutUs      String? @db.Text
  address      String?
  phone        String?
  email        String?
  logoUrl      String?
  facebookUrl  String?
  twitterUrl   String?
  linkedinUrl  String?
}

// Model for news posts.
model Post {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
